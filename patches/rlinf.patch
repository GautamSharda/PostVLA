+def _resolve_state_key(
+    state_dict: dict[str, np.ndarray], key: str, suffix: str
+) -> str | None:
+    candidates = (
+        (f"{key}{suffix}", key, f"{key}/value")
+        if suffix
+        else (key, f"{key}/value")
+    )
+    for candidate in candidates:
+        if candidate in state_dict:
+            return candidate
+    return None
+
+
+def _fold_lora_delta(
+    state_dict: dict[str, np.ndarray],
+    weight_key: str,
+    lora_a_key: str,
+    lora_b_key: str,
+    suffix: str,
+) -> bool:
+    resolved_weight_key = _resolve_state_key(state_dict, weight_key, suffix)
+    resolved_lora_a_key = _resolve_state_key(state_dict, lora_a_key, suffix)
+    resolved_lora_b_key = _resolve_state_key(state_dict, lora_b_key, suffix)
+    if (
+        resolved_weight_key is None
+        or resolved_lora_a_key is None
+        or resolved_lora_b_key is None
+    ):
+        return False
+
+    weight = state_dict[resolved_weight_key]
+    delta = np.einsum(
+        "...dr,...rh->...dh",
+        state_dict.pop(resolved_lora_a_key),
+        state_dict.pop(resolved_lora_b_key),
+    )
+    if weight.shape != delta.shape:
+        raise ValueError(
+            f"LoRA delta shape {delta.shape} does not match "
+            f"{resolved_weight_key} shape {weight.shape}"
+        )
+    state_dict[resolved_weight_key] = weight + delta.astype(weight.dtype, copy=False)
+    return True
+
+
